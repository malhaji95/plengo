# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/plengo_dev

BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
APP_WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3000

MOBILE_ACCESS_JWT_SECRET=change-me-dev-access-secret-32-characters
MOBILE_REFRESH_TOKEN_PEPPER=change-me-dev-refresh-pepper-32-characters
COUPON_HMAC_SECRET=change-me-dev-coupon-hmac-secret-32-chars
# 32 random bytes, base64 (openssl rand -base64 32)
COUPON_ENCRYPTION_KEY=ZGV2LW9ubHktY291cG9uLWVuY3J5cHRpb24ta2V5ISE=

# memory = in-process storage for local dev without R2; use r2 (or MinIO via R2_ENDPOINT) otherwise
STORAGE_DRIVER=memory
# Keeps dev uploads and seeded images across restarts (ignored by git).
LOCAL_STORAGE_DIR=.dev-storage
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=media-private
# R2_PUBLIC_BUCKET=media-public
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# console = OTP emails are printed to the API log
EMAIL_PROVIDER=console
# EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Plengo <no-reply@example.com>"

# SENTRY_DSN=
JOBS_ENABLED=true
TZ_BUSINESS=Asia/Damascus
